---
import Layout from '../../layouts/Layout.astro';
import EmptySeasonState from '../../components/EmptySeasonState.astro';
import { StatsTable } from '../../components/StatsTable';
import BackButton from '../../components/BackButton.astro';
import SeasonSelect from '../../components/SeasonSelect.astro';

import fs from 'node:fs';
import path from 'node:path';

import { seasons } from '../../config/seasons';
import { teamLogos, teamColors } from '../../utils/teams';
import { findDefaultSeason } from '../../utils/seasonLoader';
import { weekWord, weekDisplay } from '../../utils/weekWord';
import { teamMeta , getStatusLabel, getStatusClasses} from '../../config/teamMeta';
import { getTeamDivision } from '../../config/divisions';

// Get the team from the URL
const { team } = Astro.params;
const decodedTeam = decodeURIComponent(team || '');

// Get team color
const colors = teamColors[decodedTeam] || { primary: '#1C1C1C', secondary: '#666666' };

// Get logo path
const logoFile = teamLogos[decodedTeam];
const logoPath = logoFile ? `/Stats-Hub/images/teams/${logoFile}` : null;

// Team metadata
const meta = teamMeta[decodedTeam];
const seasonsCount = meta?.seasonsActive.length ?? 0;
const isInactive = meta && meta.status !== 'active';

// Load data for all seasons
const playersBySeason: Record<string, any[]> = {};
const teamStatsBySeason: Record<string, any> = {};
const standingsBySeason: Record<string, any> = {};
const gameLogBySeason: Record<string, any[]> = {};

for (const season of seasons) {
  // Players
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'players_season.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const allPlayers = JSON.parse(rawData);
    playersBySeason[season] = allPlayers
      .filter((p: any) => p.team === decodedTeam)
      .sort((a: any, b: any) => {
        const numA = parseInt(String(a.player).match(/^(\d+)/)?.[1] || '999');
        const numB = parseInt(String(b.player).match(/^(\d+)/)?.[1] || '999');
        return numA - numB;
      });
  } catch (e) {
    console.error(`Failed to load players_season.json for season ${season}:`, e);
    playersBySeason[season] = [];
  }

  // Team stats
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'teams_season.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const allTeams = JSON.parse(rawData);
    teamStatsBySeason[season] = allTeams.find((t: any) => t.team === decodedTeam);
  } catch (e) {
    console.error(`Failed to load teams_season.json for season ${season}:`, e);
    teamStatsBySeason[season] = null;
  }

  // Standings
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'standings.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const standings = JSON.parse(rawData);
    standingsBySeason[season] = standings.find((t: any) => t.team === decodedTeam);
  } catch (e) {
    console.error(`Failed to load standings.json for season ${season}:`, e);
    standingsBySeason[season] = null;
  }

// Game log (team games)
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'teams_games.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const allGames = JSON.parse(rawData);
    gameLogBySeason[season] = allGames
      .filter((g: any) => g.team === decodedTeam)
      .map((g: any) => ({
        ...g,
        week: weekDisplay(String(g.week)),
        weekNum: parseInt(String(g.week).replace(/\D/g, '') || '0')
      }))
      .sort((a: any, b: any) => a.weekNum - b.weekNum);
  } catch (e) {
    console.error(`Failed to load teams_games.json for season ${season}:`, e);
    gameLogBySeason[season] = [];
  }
}

// Load upcoming matches for current season from schedule
const currentSeason = seasons[0];
let upcomingTeamGames: Array<{ week: number; weekend: string; opponent: string; opponentAbbrev: string; isHome: boolean; gameDate: string | null; gameTime: string | null; location: string | null; division: string; youtubeUrl?: string }> = [];
try {
  const scheduleData = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'data', currentSeason, 'schedule.json'), 'utf-8')
  );
  for (const week of scheduleData) {
    for (const game of week.games) {
      const isHome = game.home === decodedTeam;
      const isAway = game.away === decodedTeam;
      if ((isHome || isAway) && (game.awayScore === null || game.homeScore === null)) {
        upcomingTeamGames.push({
          week: week.week,
          weekend: week.weekend,
          opponent: isHome ? game.away : game.home,
          opponentAbbrev: isHome ? game.awayAbbrev : game.homeAbbrev,
          isHome,
          gameDate: game.gameDate,
          gameTime: game.gameTime,
          location: game.location,
          division: game.division,
          youtubeUrl: game.youtubeUrl,
        });
      }
    }
  }
  upcomingTeamGames.sort((a, b) => a.week - b.week);
} catch (e) {}

// Previous seasons with standings data (excludes current season)
const pastSeasonsWithData = seasons.filter(s => s !== currentSeason && standingsBySeason[s]);

// Find default season (first season with actual data)
const defaultSeason = findDefaultSeason(
  seasons,
  // Build a combined lookup — use playersBySeason since it's an array
  Object.fromEntries(seasons.map(s => [s, playersBySeason[s] || []])),
  ['goals', 'assists', 'blocks']
);

// Generate static paths for all teams
export async function getStaticPaths() {
  const fs = await import('node:fs');
  const path = await import('node:path');
  
  const teams = new Set<string>();
  
  for (const season of seasons) {
    try {
      const dataPath = path.join(process.cwd(), 'data', season, 'teams_season.json');
      const rawData = fs.readFileSync(dataPath, 'utf-8');
      const teamsData = JSON.parse(rawData);
      teamsData.forEach((t: any) => teams.add(t.team));
    } catch (e) {
      console.error(`Failed to load teams_season.json for season ${season} in getStaticPaths:`, e);
    }
  }
  
  return Array.from(teams).map(team => ({
    params: { team: team }
  }));
}

const playerColumns = [
  { accessorKey: 'player', header: 'Player', size: 200 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'assists', header: 'Assists', size: 80 },
  { accessorKey: 'secondaryAssists', header: '2nd Assists', size: 100 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: 'touches', header: 'Touches', size: 90 },
  { accessorKey: '+/-', header: '+/-', size: 70 },
  { accessorKey: 'throws', header: 'Throws', size: 80 },
  { accessorKey: 'catches', header: 'Catches', size: 80 },
  { accessorKey: 'offensePoints', header: 'O-Pts', size: 70 },
  { accessorKey: 'defensePoints', header: 'D-Pts', size: 70 },
  { accessorKey: 'possessionsInitiated', header: 'Poss. Init.', size: 90 },
  { accessorKey: 'throwerErrors', header: 'Throw Err', size: 90 },
  { accessorKey: 'receiverErrors', header: 'Recv Err', size: 85 },
  { accessorKey: 'totalThrowYards', header: 'Throw Yds', size: 95 },
  { accessorKey: 'avgThrowYards', header: 'Avg Throw Yds', size: 115 },
  { accessorKey: 'totalCatchYards', header: 'Catch Yds', size: 95 },
  { accessorKey: 'avgCatchYards', header: 'Avg Catch Yds', size: 115 },
];

const playerHiddenByDefault = [
  'secondaryAssists',
  'throws',
  'catches',
  'offensePoints',
  'defensePoints',
  'possessionsInitiated',
  'throwerErrors',
  'receiverErrors',
  'totalThrowYards',
  'avgThrowYards',
  'totalCatchYards',
  'avgCatchYards',
];

const gameLogColumns = [
  { accessorKey: 'match', header: 'Match', size: 180 },
  { accessorKey: 'week', header: 'Week', size: 80 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'breakGoals', header: 'Break Goals', size: 100 },
  { accessorKey: 'holds', header: 'Holds', size: 70 },
  { accessorKey: 'cleanHolds', header: 'Clean Holds', size: 100 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'passAttempts', header: 'Pass Att.', size: 90 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: 'completedPasses', header: 'Comp. Passes', size: 110 },
  { accessorKey: 'completionRate', header: 'Comp. %', size: 80 },
  { accessorKey: 'hucks', header: 'Hucks', size: 70 },
];

const gameLogHiddenByDefault = [
  'passAttempts',
  'completedPasses',
];
---

<Layout title={decodedTeam}>
  <div class="space-y-8">
    <!-- Back link (uses history.back with fallback) -->
      <BackButton fallback="/Stats-Hub/teams" />

    <!-- Team Hero Banner -->
    <div 
      class="relative -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-8 mb-8"
      style={`background: linear-gradient(135deg, ${colors.primary} 0%, ${colors.primary}dd 50%, ${colors.secondary} 100%);`}
    >
    <div class="flex items-center gap-6">
      {logoPath && (
        <img 
          src={logoPath} 
          alt={`${decodedTeam} logo`}
          class="w-20 h-20 sm:w-24 sm:h-24 object-contain bg-white rounded-full p-2 shadow-lg"
        />
      )}
      <div class="text-white flex-1">
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-3xl sm:text-4xl font-bold drop-shadow-md">{decodedTeam}</h1>
          {isInactive && meta && (
            <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${getStatusClasses(meta.status)}`}>
              {getStatusLabel(meta.status)}
            </span>
          )}
        </div>
        <p id="team-subtitle" class="text-white/80 mt-1 drop-shadow">
          {standingsBySeason[defaultSeason] 
            ? `${standingsBySeason[defaultSeason].wins}-${standingsBySeason[defaultSeason].losses} • ${standingsBySeason[defaultSeason].division} Division`
            : `${defaultSeason} Season`
          }
        </p>
        {meta && (
          <p class="text-white/60 text-sm mt-1 drop-shadow">
            {meta.location} • Est. {meta.founded} • {seasonsCount} {seasonsCount === 1 ? 'season' : 'seasons'}
            {meta.statusNote ? ` • ${meta.statusNote}` : ''}
          </p>
        )}
      </div>
        <SeasonSelect 
          seasons={seasons} 
          defaultSeason={defaultSeason}
          class="search-input text-sm bg-white/90 text-pul-black border-white/50 rounded-lg px-3 py-2"
        />
      </div>
    </div>

    {seasons.map(season => {
      const teamStats = teamStatsBySeason[season];
      const teamPlayers = playersBySeason[season];
      const teamGames = gameLogBySeason[season];
      
      return (
        <div data-season={season} class={season === defaultSeason ? '' : 'hidden'}>
          <!-- Team Stats Summary -->
          {teamStats && ((teamStats.goals || 0) + (teamStats.blocks || 0) + (teamStats.breakGoals || 0) > 0) ? (
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
              <div class="p-4 border border-pul-border rounded">
                <div class="text-2xl font-semibold">{teamStats.goals || 0}</div>
                <div class="text-sm text-pul-gray">Goals</div>
              </div>
              {teamStats.breakGoals !== undefined && (
                <div class="p-4 border border-pul-border rounded">
                  <div class="text-2xl font-semibold">{teamStats.breakGoals}</div>
                  <div class="text-sm text-pul-gray">Break Goals</div>
                </div>
              )}
              <div class="p-4 border border-pul-border rounded">
                <div class="text-2xl font-semibold">{teamStats.blocks || 0}</div>
                <div class="text-sm text-pul-gray">Defensive Blocks</div>
              </div>
              <div class="p-4 border border-pul-border rounded">
                <div class="text-2xl font-semibold">{teamStats.holds || 0}</div>
                <div class="text-sm text-pul-gray">Holds</div>
              </div>
              {teamStats.cleanHolds !== undefined && (
                <div class="p-4 border border-pul-border rounded">
                  <div class="text-2xl font-semibold">{teamStats.cleanHolds}</div>
                  <div class="text-sm text-pul-gray">Clean Holds</div>
                </div>
              )}
              {teamStats.passAttempts !== undefined && (
                <div class="p-4 border border-pul-border rounded">
                  <div class="text-2xl font-semibold">{teamStats.passAttempts}</div>
                  <div class="text-sm text-pul-gray">Pass Attempts</div>
                </div>
              )}
              <div class="p-4 border border-pul-border rounded">
                <div class="text-2xl font-semibold">{teamStats.turnovers || 0}</div>
                <div class="text-sm text-pul-gray">Turnovers</div>
              </div>
              {teamStats.completedPasses !== undefined && (
                <div class="p-4 border border-pul-border rounded">
                  <div class="text-2xl font-semibold">{teamStats.completedPasses}</div>
                  <div class="text-sm text-pul-gray">Comp. Passes</div>
                </div>
              )}
              {teamStats.completionRate !== undefined && teamStats.completionRate > 0 && (
                <div class="p-4 border border-pul-border rounded">
                  <div class="text-2xl font-semibold">{teamStats.completionRate}%</div>
                  <div class="text-sm text-pul-gray">Comp. Rate</div>
                </div>
              )}
              {teamStats.hucks !== undefined && (
                <div class="p-4 border border-pul-border rounded">
                  <div class="text-2xl font-semibold">{teamStats.hucks}</div>
                  <div class="text-sm text-pul-gray">Hucks</div>
                </div>
              )}
            </div>
          ) : (
            <EmptySeasonState type="team" />
          )}

          <!-- Tabs: Roster / Game Log -->
          <div class="border-b border-pul-border mb-4">
            <nav class="flex gap-6">
              <button class="tab-btn py-3 text-sm font-medium border-b-2 border-pul-black" data-tab="roster">
                Roster ({teamPlayers.length})
              </button>
              <button class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-pul-gray hover:text-pul-black" data-tab="game-log">
                Game Log ({teamGames.length})
              </button>
            </nav>
          </div>

          <!-- Roster Tab -->
          <div data-tab-content="roster">
            {teamPlayers.length > 0 ? (
              <StatsTable 
                client:load
                data={teamPlayers}
                columns={playerColumns}
                defaultHiddenColumns={playerHiddenByDefault}
                teamLogos={teamLogos}
                searchPlaceholder="Search players..."
                searchableColumns={['player']}
                playerLinkColumn="player"
              />
            ) : (
              <EmptySeasonState type="roster" />
            )}
          </div>

          <!-- Game Log Tab -->
          <div data-tab-content="game-log" class="hidden">
            {/* Upcoming games for current season */}
            {season === currentSeason && upcomingTeamGames.length > 0 && (
              <div class="mb-6">
                <h3 class="text-base font-semibold mb-3 text-pul-gray">Upcoming</h3>
                <div class="divide-y divide-pul-border border border-pul-border rounded-lg overflow-hidden">
                  {upcomingTeamGames.map(game => {
                    const opponentLogo = teamLogos[game.opponent];
                    return (
                      <div class="flex items-center justify-between px-4 py-3 hover:bg-pul-light transition-colors">
                        <div class="flex items-center gap-3">
                          <span class="text-xs font-medium text-pul-gray w-14">Wk {weekWord(game.week)}</span>
                          {opponentLogo && (
                            <img src={`/Stats-Hub/images/teams/${opponentLogo}`} alt={game.opponent} class="w-8 h-8 object-contain" />
                          )}
                          <div>
                            <div class="text-sm font-medium">
                              {game.isHome ? 'vs' : '@'}{' '}
                              <a href={`/Stats-Hub/teams/${encodeURIComponent(game.opponent)}`} class="hover:underline">
                                {game.opponent}
                              </a>
                            </div>
                            {(game.gameDate || game.gameTime) && (
                              <div class="text-xs text-pul-gray">
                                {game.gameDate}{game.gameDate && game.gameTime ? ' · ' : ''}{game.gameTime ? `${game.gameTime} EST` : ''}
                              </div>
                            )}
                          </div>
                        </div>
                        <div class="flex items-center gap-2">
                          {game.youtubeUrl && (
                            <a
                              href={game.youtubeUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="inline-flex items-center gap-1 px-2.5 py-1 bg-red-600 text-white text-xs font-medium rounded hover:bg-red-700 transition-colors"
                            >
                              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                              </svg>
                              Watch
                            </a>
                          )}
                          <a href={`/Stats-Hub/schedule#week-${game.week}`} class="text-xs text-pul-gray hover:text-pul-black transition-colors">
                            Schedule →
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
            {teamGames.length > 0 ? (
              <StatsTable
                client:load
                data={teamGames}
                columns={gameLogColumns}
                defaultHiddenColumns={gameLogHiddenByDefault}
                teamLogos={teamLogos}
                searchPlaceholder="Search matchups..."
                searchableColumns={['match']}
                filterColumn="week"
                filterLabel="Weeks"
                gameLinkColumn="match"
              />
            ) : season !== currentSeason ? (
              <EmptySeasonState type="game" />
            ) : upcomingTeamGames.length === 0 ? (
              <EmptySeasonState type="game" />
            ) : null}
          </div>
        </div>
      );
    })}

    <!-- Previous Seasons Results -->
    {pastSeasonsWithData.length > 0 && (
      <div class="mt-8 pt-8 border-t border-pul-border">
        <h2 class="text-xl font-semibold mb-4">Season History</h2>
        <div class="overflow-x-auto border border-pul-border rounded-lg">
          <table class="stats-table w-full">
            <thead>
              <tr>
                <th class="text-left">Season</th>
                <th class="text-left">Division</th>
                <th class="text-right">W</th>
                <th class="text-right">L</th>
                <th class="text-right">Win %</th>
                <th class="text-right">PF</th>
                <th class="text-right">PA</th>
              </tr>
            </thead>
            <tbody>
              {pastSeasonsWithData.map(s => {
                const st = standingsBySeason[s];
                const gp = (st.wins || 0) + (st.losses || 0);
                const winPct = gp > 0 ? `${((st.wins || 0) / gp * 100).toFixed(1)}%` : '—';
                return (
                  <tr>
                    <td>{s}</td>
                    <td>{st.division || '—'}</td>
                    <td class="text-right tabular-nums">{st.wins ?? '—'}</td>
                    <td class="text-right tabular-nums">{st.losses ?? '—'}</td>
                    <td class="text-right tabular-nums">{winPct}</td>
                    <td class="text-right tabular-nums">{st.pointsFor ?? '—'}</td>
                    <td class="text-right tabular-nums">{st.pointsAgainst ?? '—'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

<script>
  import '../../scripts/tabSwitcher';

  // Page-specific: update subtitle on season change
  const subtitleData = JSON.parse(document.getElementById('subtitle-data')?.textContent || '{}');
  const teamSubtitle = document.getElementById('team-subtitle');

  document.addEventListener('seasonchange', ((e: CustomEvent) => {
    const selected = e.detail.season;
    if (teamSubtitle) {
      teamSubtitle.textContent = subtitleData[selected] || `${selected} Season`;
    }
  }) as EventListener);
</script>

<!-- Inline data for subtitle updates -->
<script id="subtitle-data" type="application/json" set:html={JSON.stringify(
  Object.fromEntries(seasons.map(s => [
    s, 
    standingsBySeason[s] 
      ? `${standingsBySeason[s].wins}-${standingsBySeason[s].losses} • ${standingsBySeason[s].division} Division`
      : getTeamDivision(decodedTeam, s)
        ? `${s} • ${getTeamDivision(decodedTeam, s)} Division`
        : `${s} Season`
  ]))
)} />
</Layout>
