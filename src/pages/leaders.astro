---
import Layout from '../layouts/Layout.astro';
import EmptySeasonState from '../components/EmptySeasonState.astro';
import SeasonSelect from '../components/SeasonSelect.astro';

import { loadSeasonData, findDefaultSeason } from '../utils/seasonLoader';
import { seasons } from '../config/seasons';
import { teamLogos } from '../utils/teams';

const playersBySeason = loadSeasonData(seasons, 'players_season.json');

const defaultSeason = findDefaultSeason(
  seasons,
  playersBySeason,
  ['goals', 'assists', 'blocks']
);

// Aggregate career totals
const careerPlayers: Map<string, any> = new Map();

for (const season of seasons) {
  (playersBySeason[season] || []).forEach((player: any) => {
    if (!player.player || typeof player.player !== 'string') return;
    const key = player.player.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    
    if (careerPlayers.has(key)) {
      const existing = careerPlayers.get(key);
      existing.goals += player.goals || 0;
      existing.assists += player.assists || 0;
      existing.blocks += player.blocks || 0;
      existing.turnovers += player.turnovers || 0;
      existing.touches += player.touches || 0;
    } else {
      careerPlayers.set(key, {
        player: player.player,
        team: player.team + ' (+ more)',
        goals: player.goals || 0,
        assists: player.assists || 0,
        blocks: player.blocks || 0,
        turnovers: player.turnovers || 0,
        touches: player.touches || 0,
      });
    }
  });
}

// For single-season players, clean up the team name
careerPlayers.forEach((player, key) => {
  let seasonCount = 0;
  for (const season of seasons) {
    if ((playersBySeason[season] || []).some((p: any) => 
      p.player && typeof p.player === 'string' && p.player.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase() === key
    )) {
      seasonCount++;
    }
  }
  if (seasonCount === 1) {
    player.team = player.team.replace(' (+ more)', '');
  }
});

playersBySeason['career'] = Array.from(careerPlayers.values());

// Helper to get top N players by a stat with tied rankings
const getLeadersWithRanks = (players: any[], stat: string, n: number = 5) => {
  const sorted = [...players]
    .sort((a, b) => (b[stat] || 0) - (a[stat] || 0));
  
  const result: any[] = [];
  let rank = 1;
  
  for (let i = 0; i < sorted.length && result.length < n; i++) {
    const value = sorted[i][stat] || 0;
    // If same value as previous, same rank
    if (i > 0 && value === (sorted[i - 1][stat] || 0)) {
      result.push({ ...sorted[i], rank: result[result.length - 1].rank });
    } else {
      result.push({ ...sorted[i], rank: i + 1 });
    }
  }
  
  // If the last included player is tied with the next one, include those too
  const lastValue = result.length > 0 ? result[result.length - 1][stat] : -1;
  for (let i = result.length; i < sorted.length; i++) {
    if ((sorted[i][stat] || 0) === lastValue) {
      result.push({ ...sorted[i], rank: result[result.length - 1].rank });
    } else {
      break;
    }
  }
  
  return result;
};

// Define leader categories
const categories = [
  { key: 'goals', title: 'Goals', icon: '🥏' },
  { key: 'assists', title: 'Assists', icon: '🎯' },
  { key: 'blocks', title: 'Blocks', icon: '🛡️' },
  { key: 'touches', title: 'Touches', icon: '✋' },
];

// Pre-compute leaders for all seasons with matched heights
const leadersBySeason: Record<string, Record<string, any[]>> = {};

for (const seasonKey of [...seasons, 'career']) {
  const seasonPlayers = playersBySeason[seasonKey] || [];
  if (seasonPlayers.length === 0) {
    leadersBySeason[seasonKey] = {};
    continue;
  }
  
  // Get raw leaders per category
  const rawLeaders: Record<string, any[]> = {};
  categories.forEach(cat => {
    rawLeaders[cat.key] = getLeadersWithRanks(seasonPlayers, cat.key);
  });
  
  // Find max count across categories
  const maxCount = Math.max(...Object.values(rawLeaders).map(l => l.length));
  
  // Pad shorter lists
  const padded: Record<string, any[]> = {};
  categories.forEach(cat => {
    const leaders = rawLeaders[cat.key];
    const sorted = [...seasonPlayers].sort((a, b) => (b[cat.key] || 0) - (a[cat.key] || 0));
    const result = [...leaders];
    let nextIndex = result.length;
    
    while (result.length < maxCount && nextIndex < sorted.length) {
      const value = sorted[nextIndex][cat.key] || 0;
      const prevValue = sorted[nextIndex - 1]?.[cat.key] || 0;
      if (value === prevValue) {
        result.push({ ...sorted[nextIndex], rank: result[result.length - 1].rank });
      } else {
        result.push({ ...sorted[nextIndex], rank: nextIndex + 1 });
      }
      nextIndex++;
    }
    padded[cat.key] = result;
  });
  
  leadersBySeason[seasonKey] = padded;
}
---

<Layout title="Season Leaders">
  <div class="space-y-8">
    <div class="flex items-baseline justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-3xl font-semibold"><span id="leaders-title">{defaultSeason}</span> Season Leaders</h1>
        <p class="text-pul-gray mt-1">Top performers in key statistical categories</p>
      </div>
      <SeasonSelect 
        seasons={seasons} 
        defaultSeason={defaultSeason} 
        titleId="leaders-title"
        extraOptions={[{ value: 'career', label: 'Career Totals' }]}
      />
    </div>

    {seasons.map(season => (
      <div data-season={season} class={season === defaultSeason ? '' : 'hidden'}>
          {playersBySeason[season].length > 0 && playersBySeason[season].some((p: any) => (p.goals || 0) + (p.assists || 0) + (p.blocks || 0) > 0) ? (
          <div class="grid md:grid-cols-2 gap-6">
            {categories.map(cat => {
              const leaders = leadersBySeason[season]?.[cat.key] || [];
              return (
                <div class="border border-pul-border rounded-lg overflow-hidden" id={`${season}-${cat.key}`}>
                  <div class="bg-pul-light px-4 py-3 border-b border-pul-border flex items-center justify-between">
                    <h2 class="font-semibold flex items-center gap-2">
                      <span>{cat.icon}</span>
                      <span>{cat.title}</span>
                    </h2>
                    <button 
                      class="share-btn text-pul-gray hover:text-pul-black transition-colors p-1 rounded hover:bg-white"
                      data-category={cat.key}
                      data-season={season}
                      data-title={`${season} PUL ${cat.title} Leaders`}
                      title="Share this leaderboard"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                        <polyline points="16 6 12 2 8 6"/>
                        <line x1="12" y1="2" x2="12" y2="15"/>
                      </svg>
                    </button>
                  </div>
                  <div class="divide-y divide-pul-border">
                    {leaders.map((player) => (
                      <a 
                        href={`/Stats-Hub/players/${encodeURIComponent(player.player)}`}
                        class="flex items-center justify-between px-4 py-3 hover:bg-pul-light transition-colors"
                      >
                        <div class="flex items-center gap-3">
                          <span class={`w-6 h-6 rounded-full flex items-center justify-center text-sm font-semibold ${
                            player.rank === 1 ? 'bg-yellow-400 text-yellow-900' : 
                            player.rank === 2 ? 'bg-gray-300 text-gray-700' : 
                            player.rank === 3 ? 'bg-amber-600 text-amber-100' : 
                            'bg-pul-light text-pul-gray'
                          }`}>
                            {player.rank}
                          </span>
                          <div>
                            <div class="font-medium">{player.player}</div>
                            <div class="text-sm text-pul-gray">{player.team}</div>
                          </div>
                        </div>
                        <div class="text-xl font-semibold tabular-nums">
                          {player[cat.key]}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        ) : playersBySeason[season].length > 0 ? (
          <EmptySeasonState type="leaders" />
        ) : (
          <EmptySeasonState type="player" />
        )}
      </div>
    ))}

    <div data-season="career" class="hidden">
        {playersBySeason['career'].length > 0 ? (
          <div class="grid md:grid-cols-2 gap-6">
            {categories.map(cat => {
              const leaders = leadersBySeason['career']?.[cat.key] || [];
              return (
                <div class="border border-pul-border rounded-lg overflow-hidden" id={`career-${cat.key}`}>
                <div class="bg-pul-light px-4 py-3 border-b border-pul-border flex items-center justify-between">
                    <h2 class="font-semibold flex items-center gap-2">
                      <span>{cat.icon}</span>
                      <span>{cat.title}</span>
                    </h2>
                    <button 
                      class="share-btn text-pul-gray hover:text-pul-black transition-colors p-1 rounded hover:bg-white"
                      data-category={cat.key}
                      data-season="career"
                      data-title={`PUL Career ${cat.title} Leaders`}
                      title="Share this leaderboard"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                        <polyline points="16 6 12 2 8 6"/>
                        <line x1="12" y1="2" x2="12" y2="15"/>
                      </svg>
                    </button>
                  </div>
                  <div class="divide-y divide-pul-border">
                    {leaders.map((player) => (
                      <a 
                        href={`/Stats-Hub/players/${encodeURIComponent(player.player)}`}
                        class="flex items-center justify-between px-4 py-3 hover:bg-pul-light transition-colors"
                      >
                        <div class="flex items-center gap-3">
                          <span class={`w-6 h-6 rounded-full flex items-center justify-center text-sm font-semibold ${
                            player.rank === 1 ? 'bg-yellow-400 text-yellow-900' : 
                            player.rank === 2 ? 'bg-gray-300 text-gray-700' : 
                            player.rank === 3 ? 'bg-amber-600 text-amber-100' : 
                            'bg-pul-light text-pul-gray'
                          }`}>
                            {player.rank}
                          </span>
                          <div>
                            <div class="font-medium">{player.player}</div>
                            <div class="text-sm text-pul-gray">{player.team}</div>
                          </div>
                        </div>
                        <div class="text-xl font-semibold tabular-nums">
                          {player[cat.key]}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <p class="text-pul-gray py-8">No career data available.</p>
        )}
      </div>

    <!-- Toast notification -->
    <div id="toast" class="fixed bottom-4 left-1/2 -translate-x-1/2 bg-pul-black text-white px-4 py-2 rounded-lg shadow-lg opacity-0 transition-opacity duration-300 pointer-events-none">
      Link copied to clipboard!
    </div>
  </div>

  <script>
    const seasonSelect = document.getElementById('season-select') as HTMLSelectElement;
    const seasonDivs = document.querySelectorAll('[data-season]');
    const leadersTitle = document.getElementById('leaders-title');
    const toast = document.getElementById('toast');
    
    // Career vs Season title handling
    document.addEventListener('seasonchange', ((e: CustomEvent) => {
      const selected = e.detail.season;
      const leadersTitle = document.getElementById('leaders-title');
      if (!leadersTitle?.parentElement) return;

      if (selected === 'career') {
        leadersTitle.textContent = 'Career';
        leadersTitle.parentElement.childNodes.forEach(node => {
          if (node.nodeType === 3) node.textContent = ' Leaders';
        });
      } else {
        leadersTitle.textContent = selected;
        leadersTitle.parentElement.childNodes.forEach(node => {
          if (node.nodeType === 3) node.textContent = ' Season Leaders';
        });
      }
    }) as EventListener);

    // Share button handlers
    const shareBtns = document.querySelectorAll('.share-btn');
    
    shareBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const category = btn.getAttribute('data-category');
        const season = btn.getAttribute('data-season');
        const title = btn.getAttribute('data-title');
        
        const url = `${window.location.origin}/Stats-Hub/leaders#${season}-${category}`;
        
        // Try native share first (mobile)
        if (navigator.share) {
          try {
            await navigator.share({
              title: title || 'PUL Leaders',
              url: url
            });
            return;
          } catch (err) {
            // User cancelled or share failed, fall back to clipboard
          }
        }
        
        // Fall back to clipboard
        try {
          await navigator.clipboard.writeText(url);
          showToast();
        } catch (err) {
          // Fallback for older browsers
          const textarea = document.createElement('textarea');
          textarea.value = url;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
          showToast();
        }
      });
    });

    function showToast() {
      if (toast) {
        toast.classList.remove('opacity-0');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0');
        }, 2000);
      }
    }

    // Handle hash on page load (scroll to category)
    if (window.location.hash) {
      const hash = window.location.hash.slice(1);
      const [season] = hash.split('-');
      
      // Switch to correct season
      if (season && seasonSelect) {
        seasonSelect.value = season;
        seasonSelect.dispatchEvent(new Event('change'));
      }
      
      // Scroll to category
      setTimeout(() => {
        const element = document.getElementById(hash);
        if (element) {
          element.scrollIntoView({ behavior: 'smooth', block: 'center' });
          element.classList.add('ring-2', 'ring-pul-black');
          setTimeout(() => {
            element.classList.remove('ring-2', 'ring-pul-black');
          }, 2000);
        }
      }, 100);
    }
  </script>
</Layout>