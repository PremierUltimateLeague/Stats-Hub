---
import Layout from '../../layouts/Layout.astro';
import { StatsTable } from '../../components/StatsTable';
import BackButton from '../../components/BackButton.astro';
import DataNotice from '../../components/DataNotice.astro';

import fs from 'node:fs';
import path from 'node:path';

import { seasons } from '../../config/seasons';
import { teamLogos } from '../../utils/teams';

// Get the player from the URL
const { player } = Astro.params;
const decodedPlayer = decodeURIComponent(player || '');

// Parse player number and name
const playerMatch = decodedPlayer.match(/^(\d+)\s+(.+)$/);
const playerNumber = playerMatch ? playerMatch[1] : null;
const playerName = playerMatch ? playerMatch[2] : decodedPlayer;

// Load all seasons data
const playerSeasonStats: Record<string, any> = {};
const playerGameStats: Record<string, any[]> = {};

for (const season of seasons) {
  // Season stats
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'players_season.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const allPlayers = JSON.parse(rawData);
    const found = allPlayers.find((p: any) => p.player === decodedPlayer);
    if (found) {
      playerSeasonStats[season] = found;
    }
  } catch (e) {}

  // Game stats
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'players_games.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const allGames = JSON.parse(rawData);
    const games = allGames.filter((p: any) => p.player === decodedPlayer);
    if (games.length > 0) {
      playerGameStats[season] = games;
    }
  } catch (e) {}
}

// Load headshot mapping
let headshotPath = '';
let hasHeadshot = false;

try {
  const mapData = fs.readFileSync(path.join(process.cwd(), 'data', 'headshot_map.json'), 'utf-8');
  const headshotMap = JSON.parse(mapData);
  const playerEntry = headshotMap[decodedPlayer];
  
  if (playerEntry?.headshot) {
    const filePath = path.join(process.cwd(), 'public', 'images', 'players', playerEntry.headshot);
    if (fs.existsSync(filePath)) {
      hasHeadshot = true;
      headshotPath = `/Stats-Hub/images/players/${playerEntry.headshot}`;
    }
  }
} catch (e) {}

// Get teams played for
const teamsPlayed = seasons.filter(s => playerSeasonStats[s]).map(season => ({
    season,
    team: playerSeasonStats[season].team,
    logo: teamLogos[playerSeasonStats[season].team] ? `/Stats-Hub/images/teams/${teamLogos[playerSeasonStats[season].team]}` : null,
  }));

// Calculate career totals
const careerStats = {
  goals: 0,
  assists: 0,
  secondaryAssists: 0,
  blocks: 0,
  turnovers: 0,
  touches: 0,
  throws: 0,
  catches: 0,
  offensePoints: 0,
  defensePoints: 0,
  throwerErrors: 0,
  receiverErrors: 0,
  games: 0,
  plusMinus: 0,
};

Object.values(playerSeasonStats).forEach((stats: any) => {
  careerStats.goals += stats.goals || 0;
  careerStats.assists += stats.assists || 0;
  careerStats.secondaryAssists += stats.secondaryAssists || 0;
  careerStats.blocks += stats.blocks || 0;
  careerStats.turnovers += stats.turnovers || 0;
  careerStats.touches += stats.touches || 0;
  careerStats.throws += stats.throws || 0;
  careerStats.catches += stats.catches || 0;
  careerStats.offensePoints += stats.offensePoints || 0;
  careerStats.defensePoints += stats.defensePoints || 0;
  careerStats.throwerErrors += stats.throwerErrors || 0;
  careerStats.receiverErrors += stats.receiverErrors || 0;
  careerStats.plusMinus += stats['+/-'] || 0;
});

Object.values(playerGameStats).forEach((games: any[]) => {
  careerStats.games += games.length;
});

// Generate static paths for all players
export async function getStaticPaths() {
  const fs = await import('node:fs');
  const path = await import('node:path');
  
  const players = new Set<string>();
  
  // Get players from all seasons
  for (const season of seasons) {
    try {
      const dataPath = path.join(process.cwd(), 'data', season, 'players_season.json');
      const rawData = fs.readFileSync(dataPath, 'utf-8');
      const allPlayers = JSON.parse(rawData);
      allPlayers.forEach((p: any) => players.add(p.player));
    } catch (e) {}
  }
  
  return Array.from(players).map(player => ({
    params: { player: player }
  }));
}

const gameColumns = [
  { accessorKey: 'match', header: 'Match', size: 150 },
  { accessorKey: 'week', header: 'Week', size: 80 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'assists', header: 'Assists', size: 80 },
  { accessorKey: 'secondaryAssists', header: '2nd Assists', size: 100 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: 'touches', header: 'Touches', size: 90 },
  { accessorKey: '+/-', header: '+/-', size: 70 },
  { accessorKey: 'throws', header: 'Throws', size: 80 },
  { accessorKey: 'catches', header: 'Catches', size: 80 },
  { accessorKey: 'offensePoints', header: 'O-Pts', size: 70 },
  { accessorKey: 'defensePoints', header: 'D-Pts', size: 70 },
  { accessorKey: 'possessionsInitiated', header: 'Poss. Init.', size: 90 },
  { accessorKey: 'throwerErrors', header: 'Throw Err', size: 90 },
  { accessorKey: 'receiverErrors', header: 'Recv Err', size: 85 },
  { accessorKey: 'totalThrowYards', header: 'Throw Yds', size: 95 },
  { accessorKey: 'avgThrowYards', header: 'Avg Throw Yds', size: 115 },
  { accessorKey: 'totalCatchYards', header: 'Catch Yds', size: 95 },
  { accessorKey: 'avgCatchYards', header: 'Avg Catch Yds', size: 115 },
];

const gameHiddenByDefault = [
  'secondaryAssists',
  'touches',
  'throws',
  'catches',
  'offensePoints',
  'defensePoints',
  'possessionsInitiated',
  'throwerErrors',
  'receiverErrors',
  'totalThrowYards',
  'avgThrowYards',
  'totalCatchYards',
  'avgCatchYards',
];
---

<Layout title={playerName}>
  <div class="space-y-8">
    <!-- Back link -->
    <BackButton fallback="/Stats-Hub/players" />
    <DataNotice />

    <!-- Player Header -->  
    <div class="flex items-center gap-6">
      {hasHeadshot ? (
        <img 
          src={headshotPath} 
          alt={playerName}
          class="w-24 h-24 sm:w-32 sm:h-32 rounded-full object-cover border-2 border-pul-border"
        />
      ) : (
        <div class="w-24 h-24 sm:w-32 sm:h-32 bg-pul-light rounded-full flex items-center justify-center text-3xl font-bold text-pul-gray">
          {playerNumber || '?'}
        </div>
      )}
      <div>
        <h1 class="text-3xl sm:text-4xl font-semibold">{playerName}</h1>
        {playerNumber && (
          <p class="text-xl text-pul-gray">#{playerNumber}</p>
        )}
      </div>
    </div>

    <!-- Teams Played For -->
    {teamsPlayed.length > 0 && (
      <div>
        <h2 class="text-lg font-semibold mb-3">Teams
          <DataNotice />
        </h2>
        <div class="flex flex-wrap gap-4">
          {teamsPlayed.map(({ season, team, logo }) => (
            <a 
              href={`/Stats-Hub/teams/${encodeURIComponent(team)}`}
              class="flex items-center gap-3 p-3 border border-pul-border rounded-lg hover:border-pul-black transition-colors"
            >
              {logo && (
                <img src={logo} alt={team} class="w-10 h-10 object-contain" />
              )}
              <div>
                <div class="font-medium">{team}</div>
                <div class="text-sm text-pul-gray">{season}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Career Stats -->
    <div>
      <h2 class="text-lg font-semibold mb-3">Career Stats
        <DataNotice />
      </h2>
      <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.games}</div>
          <div class="text-sm text-pul-gray">Games</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.goals}</div>
          <div class="text-sm text-pul-gray">Goals</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.assists}</div>
          <div class="text-sm text-pul-gray">Assists</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.blocks}</div>
          <div class="text-sm text-pul-gray">Blocks</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.turnovers}</div>
          <div class="text-sm text-pul-gray">Turnovers</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.touches}</div>
          <div class="text-sm text-pul-gray">Touches</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.plusMinus}</div>
          <div class="text-sm text-pul-gray">+/-</div>
        </div>
        <div class="p-4 border border-pul-border rounded text-center">
          <div class="text-2xl font-semibold">{careerStats.offensePoints + careerStats.defensePoints}</div>
          <div class="text-sm text-pul-gray">Pts Played</div>
        </div>
      </div>
    </div>

    <!-- Season-by-Season Stats -->
    {Object.entries(playerSeasonStats).length > 0 && (
      <div>
        <h2 class="text-lg font-semibold mb-3">Season Stats</h2>
        <div class="overflow-x-auto border border-pul-border rounded">
          <table class="stats-table w-full">
            <thead>
              <tr>
                <th class="text-left">Season</th>
                <th class="text-left">Team</th>
                <th class="text-right">Goals</th>
                <th class="text-right">Assists</th>
                <th class="text-right">Blocks</th>
                <th class="text-right">Turnovers</th>
                <th class="text-right">Touches</th>
                <th class="text-right">+/-</th>
                <th class="text-right">O-Pts</th>
                <th class="text-right">D-Pts</th>
              </tr>
            </thead>
            <tbody>
            {seasons.filter(s => playerSeasonStats[s]).map(season => (
              <tr>
                <td>{season}</td>
                <td>
                  <a href={`/Stats-Hub/teams/${encodeURIComponent(playerSeasonStats[season].team)}`} class="hover:underline">
                    {playerSeasonStats[season].team}
                  </a>
                </td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].goals ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].assists ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].blocks ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].turnovers ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].touches ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season]['+/-'] ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].offensePoints ?? 0}</td>
                <td class="text-right tabular-nums">{playerSeasonStats[season].defensePoints ?? 0}</td>
              </tr>
            ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Game-by-Game Stats -->
   {seasons.filter(s => playerGameStats[s]).map(season => (
      <div>
        <h2 class="text-lg font-semibold mb-3">{season} Game Log</h2>
        <StatsTable 
          client:load
          data={playerGameStats[season]}
          columns={gameColumns}
          defaultHiddenColumns={gameHiddenByDefault}
          searchPlaceholder="Search games..."
          searchableColumns={['match']}
          gameLinkColumn="match"
        />
      </div>
    ))}
  </div>
</Layout>