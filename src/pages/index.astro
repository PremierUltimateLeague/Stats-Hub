---
import Layout from '../layouts/Layout.astro';
import { loadSeasonData, findDefaultSeason } from '../utils/seasonLoader';
import { seasons } from '../config/seasons';
import { teamLogos } from '../utils/teams';
import { weekWord } from '../utils/weekWord';
import fs from 'node:fs';
import path from 'node:path';

// Load all player and team data
const playersBySeason = loadSeasonData(seasons, 'players_season.json');
const teamsBySeason = loadSeasonData(seasons, 'teams_season.json');

// Determine current season
const currentSeason = findDefaultSeason(
  seasons,
  playersBySeason,
  ['goals', 'assists', 'blocks']
);

// Use only the active season's data
const players = playersBySeason[currentSeason] || [];
const teams = teamsBySeason[currentSeason] || [];

// Get leaders for homepage - ensure all boxes match height
const getHomeLeaders = (data: any[], stat: string) => {
  const sorted = [...data].sort((a, b) => (b[stat] || 0) - (a[stat] || 0));
  const result: any[] = [];

  for (let i = 0; i < sorted.length && result.length < 3; i++) {
    const value = sorted[i][stat] || 0;
    if (i > 0 && value === (sorted[i - 1][stat] || 0)) {
      result.push({ ...sorted[i], rank: result[result.length - 1].rank });
    } else {
      result.push({ ...sorted[i], rank: i + 1 });
    }
  }

  // Include ties at cutoff
  const lastValue = result.length > 0 ? result[result.length - 1][stat] : -1;
  for (let i = result.length; i < sorted.length; i++) {
    if ((sorted[i][stat] || 0) === lastValue) {
      result.push({ ...sorted[i], rank: result[result.length - 1].rank });
    } else {
      break;
    }
  }

  return result;
};

const goalLeaders = getHomeLeaders(players, 'goals');
const assistLeaders = getHomeLeaders(players, 'assists');
const blockLeaders = getHomeLeaders(players, 'blocks');

// Find the max count across all three categories
const maxLeaderCount = Math.max(goalLeaders.length, assistLeaders.length, blockLeaders.length);

// Pad shorter lists to match
const padLeaders = (leaders: any[], stat: string) => {
  const sorted = [...players].sort((a, b) => (b[stat] || 0) - (a[stat] || 0));
  const result = [...leaders];
  let nextIndex = result.length;

  while (result.length < maxLeaderCount && nextIndex < sorted.length) {
    const value = sorted[nextIndex][stat] || 0;
    const prevValue = sorted[nextIndex - 1]?.[stat] || 0;
    if (value === prevValue) {
      result.push({ ...sorted[nextIndex], rank: result[result.length - 1].rank });
    } else {
      result.push({ ...sorted[nextIndex], rank: nextIndex + 1 });
    }
    nextIndex++;
  }
  return result;
};

const paddedGoalLeaders = padLeaders(goalLeaders, 'goals');
const paddedAssistLeaders = padLeaders(assistLeaders, 'assists');
const paddedBlockLeaders = padLeaders(blockLeaders, 'blocks');
const topTeams = getHomeLeaders(teams, 'goals');

// Load upcoming matches from current season schedule
let upcomingGames: Array<{ week: number; weekend: string; away: string; home: string; awayAbbrev: string; homeAbbrev: string; division: string; gameDate: string | null; gameTime: string | null; location: string | null; youtubeUrl?: string }> = [];
try {
  const scheduleData = JSON.parse(
    fs.readFileSync(path.join(process.cwd(), 'data', seasons[0], 'schedule.json'), 'utf-8')
  );
  const upcomingWeek = scheduleData.find((week: any) =>
    week.games.some((g: any) => g.awayScore === null || g.homeScore === null)
  );
  if (upcomingWeek) {
    upcomingGames = upcomingWeek.games
      .filter((g: any) => g.awayScore === null || g.homeScore === null)
      .map((g: any) => ({ ...g, week: upcomingWeek.week, weekend: upcomingWeek.weekend }));
  }
} catch (e) {}
---


<Layout title="Home">
  <div class={upcomingGames.length > 0 ? 'lg:grid lg:grid-cols-[264px_1fr] lg:gap-8 lg:items-start' : ''}>

    <!-- ── Sidebar: upcoming games (desktop only) ───────────────────── -->
    {upcomingGames.length > 0 && (
      <aside class="hidden lg:block sticky top-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-pul-gray mb-2">Upcoming</p>
        <h2 class="text-base font-semibold">Week {weekWord(upcomingGames[0].week)}</h2>
        <p class="text-sm text-pul-gray mb-4">{upcomingGames[0].weekend}</p>

        <div class="space-y-2.5">
          {upcomingGames.map(game => {
            const awayLogo = teamLogos[game.away];
            const homeLogo = teamLogos[game.home];
            const divClass = game.division === 'North'
              ? 'bg-blue-50 text-blue-700 border-blue-100'
              : game.division === 'South'
              ? 'bg-orange-50 text-orange-700 border-orange-100'
              : 'bg-purple-50 text-purple-700 border-purple-100';
            return (
              <div class="border border-pul-border rounded-lg overflow-hidden">
                {/* Division badge */}
                <div class={`flex justify-between items-center px-2.5 py-1 border-b text-xs font-medium ${divClass}`}>
                  <span>{game.division} Division</span>
                  {game.gameDate && <span>{game.gameDate}</span>}
                </div>

                {/* Teams */}
                <div class="px-2.5 py-2">
                  {(game.gameTime || game.location) && (
                    <p class="text-xs text-pul-gray mb-2 pb-2 border-b border-pul-border">
                      {game.gameTime && <span>🕐 {game.gameTime} EST</span>}
                      {game.gameTime && game.location && <span class="mx-1">·</span>}
                      {game.location && <span>📍 {game.location}</span>}
                    </p>
                  )}

                  <div class="flex items-center gap-2 py-1.5">
                    {awayLogo && <img src={`/Stats-Hub/images/teams/${awayLogo}`} alt={game.away} class="w-7 h-7 object-contain flex-shrink-0" />}
                    <span class="text-sm font-medium leading-tight">{game.away}</span>
                  </div>
                  <div class="border-t border-pul-border"></div>
                  <div class="flex items-center gap-2 py-1.5">
                    {homeLogo && <img src={`/Stats-Hub/images/teams/${homeLogo}`} alt={game.home} class="w-7 h-7 object-contain flex-shrink-0" />}
                    <span class="text-sm font-medium leading-tight">{game.home}</span>
                  </div>
                </div>

                {/* Footer */}
                <div class="flex items-center justify-between px-2.5 py-1.5 border-t border-pul-border">
                  <a href={`/Stats-Hub/schedule#week-${game.week}`} class="text-xs text-pul-gray hover:text-pul-black transition-colors">
                    Schedule →
                  </a>
                  {game.youtubeUrl && (
                    <a href={game.youtubeUrl} target="_blank" rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 px-2 py-0.5 bg-red-600 text-white text-xs font-medium rounded hover:bg-red-700 transition-colors">
                      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                      </svg>
                      Watch
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        <a href="/Stats-Hub/schedule" class="mt-3 block text-center text-xs text-pul-gray border border-pul-border rounded-lg py-2 hover:text-pul-black hover:border-pul-black transition-colors">
          Full schedule →
        </a>
      </aside>
    )}

    <!-- ── Main content column ──────────────────────────────────────── -->
    <div class="space-y-12">

      <!-- Hero -->
      <section class="py-4 animate-fade-in">
        <h1 class="text-4xl md:text-5xl font-semibold mb-3">
          {currentSeason} Season
        </h1>
        <p class="text-pul-gray text-lg mb-8">
          Comprehensive statistics for the Premier Ultimate League.
        </p>
        <div class="grid sm:grid-cols-2 gap-4 animate-fade-in-delay-1">
          <a
            href="/Stats-Hub/teams"
            class="block p-6 bg-pul-blue text-pul-black rounded-lg hover:bg-pul-blue/80 transition-colors"
          >
            <h2 class="text-2xl font-semibold mb-1">Team Stats →</h2>
            <p class="text-pul-black/60 text-sm">Season totals and game-by-game breakdowns for all {teams.length} teams</p>
          </a>
          <a
            href="/Stats-Hub/players"
            class="block p-6 bg-pul-blue text-pul-black rounded-lg hover:bg-pul-blue/80 transition-colors"
          >
            <h2 class="text-2xl font-semibold mb-1">Player Stats →</h2>
            <p class="text-pul-black/60 text-sm">Individual stats across all {players.length} players</p>
          </a>
        </div>
      </section>

      <!-- ── Mobile: collapsible upcoming bar (hidden on desktop) ──── -->
      {upcomingGames.length > 0 && (
        <section class="lg:hidden animate-fade-in-delay-1">
          <div class="border border-pul-border rounded-lg overflow-hidden">
            <button
              id="upcoming-toggle"
              class="w-full flex items-center justify-between px-4 py-3 bg-pul-light hover:bg-pul-border/40 transition-colors text-left"
              aria-expanded="false"
            >
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></span>
                <span class="text-sm font-semibold">
                  Week {weekWord(upcomingGames[0].week)} Upcoming
                  <span class="font-normal text-pul-gray"> · {upcomingGames[0].weekend}</span>
                </span>
              </div>
              <div class="flex items-center gap-3 text-xs text-pul-gray flex-shrink-0">
                <span>{upcomingGames.length} game{upcomingGames.length !== 1 ? 's' : ''}</span>
                <svg id="upcoming-chevron" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </button>

            <div id="upcoming-body" class="hidden border-t border-pul-border divide-y divide-pul-border">
              {upcomingGames.map(game => {
                const awayLogo = teamLogos[game.away];
                const homeLogo = teamLogos[game.home];
                const dotColor = game.division === 'North'
                  ? 'bg-blue-600'
                  : game.division === 'South'
                  ? 'bg-orange-600'
                  : 'bg-purple-600';
                return (
                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class={`w-2 h-2 rounded-full flex-shrink-0 ${dotColor}`}></span>
                    <div class="flex items-center gap-2 flex-1 min-w-0">
                      {awayLogo && <img src={`/Stats-Hub/images/teams/${awayLogo}`} alt={game.away} class="w-6 h-6 object-contain flex-shrink-0" />}
                      <span class="text-sm font-medium">{game.awayAbbrev}</span>
                      <span class="text-xs text-pul-gray">vs</span>
                      {homeLogo && <img src={`/Stats-Hub/images/teams/${homeLogo}`} alt={game.home} class="w-6 h-6 object-contain flex-shrink-0" />}
                      <span class="text-sm font-medium">{game.homeAbbrev}</span>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                      {game.gameTime && <span class="text-xs text-pul-gray">{game.gameTime}</span>}
                      {game.youtubeUrl && (
                        <a href={game.youtubeUrl} target="_blank" rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-2 py-0.5 bg-red-600 text-white text-xs font-medium rounded hover:bg-red-700 transition-colors">
                          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                          </svg>
                          Watch
                        </a>
                      )}
                    </div>
                  </div>
                );
              })}
              <div class="px-4 py-2.5 text-center">
                <a href="/Stats-Hub/schedule" class="text-xs text-pul-gray hover:text-pul-black transition-colors">
                  Full schedule →
                </a>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Leaders Preview -->
      {players.length > 0 && (
        <section>
          <div class="flex items-baseline justify-between mb-4 animate-fade-in-delay-2">
            <a href="/Stats-Hub/leaders" class="text-xl font-semibold hover:underline">Season Leaders</a>
            <a href="/Stats-Hub/leaders" class="text-sm text-pul-gray hover:text-pul-black transition-colors">
              View all →
            </a>
          </div>

          <div class="grid sm:grid-cols-3 gap-4 animate-fade-in-delay-3">
            <!-- Goals Leaders -->
            <div class="border border-pul-border rounded-lg overflow-hidden">
              <div class="bg-pul-light px-4 py-2 border-b border-pul-border">
                <h3 class="font-medium text-sm">🥏 Goals</h3>
              </div>
              <div class="divide-y divide-pul-border">
                {paddedGoalLeaders.map((player) => (
                  <a href={`/Stats-Hub/players/${encodeURIComponent(player.player)}`} class="flex items-center justify-between px-4 py-2 hover:bg-pul-light transition-colors">
                    <div class="flex items-center gap-2">
                      <span class={`w-5 h-5 rounded-full flex items-center justify-center text-xs font-semibold ${
                        player.rank === 1 ? 'bg-yellow-400 text-yellow-900' :
                        player.rank === 2 ? 'bg-gray-300 text-gray-700' :
                        player.rank === 3 ? 'bg-amber-600 text-amber-100' :
                        'bg-pul-light text-pul-gray'
                      }`}>{player.rank}</span>
                      <div>
                        <span class="text-sm">{player.player}</span>
                        <div class="text-xs text-pul-gray">{player.team}</div>
                      </div>
                    </div>
                    <span class="font-semibold tabular-nums">{player.goals}</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Assists Leaders -->
            <div class="border border-pul-border rounded-lg overflow-hidden">
              <div class="bg-pul-light px-4 py-2 border-b border-pul-border">
                <h3 class="font-medium text-sm">🎯 Assists</h3>
              </div>
              <div class="divide-y divide-pul-border">
                {paddedAssistLeaders.map((player) => (
                  <a href={`/Stats-Hub/players/${encodeURIComponent(player.player)}`} class="flex items-center justify-between px-4 py-2 hover:bg-pul-light transition-colors">
                    <div class="flex items-center gap-2">
                      <span class={`w-5 h-5 rounded-full flex items-center justify-center text-xs font-semibold ${
                        player.rank === 1 ? 'bg-yellow-400 text-yellow-900' :
                        player.rank === 2 ? 'bg-gray-300 text-gray-700' :
                        player.rank === 3 ? 'bg-amber-600 text-amber-100' :
                        'bg-pul-light text-pul-gray'
                      }`}>{player.rank}</span>
                      <div>
                        <span class="text-sm">{player.player}</span>
                        <div class="text-xs text-pul-gray">{player.team}</div>
                      </div>
                    </div>
                    <span class="font-semibold tabular-nums">{player.assists}</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Blocks Leaders -->
            <div class="border border-pul-border rounded-lg overflow-hidden">
              <div class="bg-pul-light px-4 py-2 border-b border-pul-border">
                <h3 class="font-medium text-sm">🛡️ Blocks</h3>
              </div>
              <div class="divide-y divide-pul-border">
                {paddedBlockLeaders.map((player) => (
                  <a href={`/Stats-Hub/players/${encodeURIComponent(player.player)}`} class="flex items-center justify-between px-4 py-2 hover:bg-pul-light transition-colors">
                    <div class="flex items-center gap-2">
                      <span class={`w-5 h-5 rounded-full flex items-center justify-center text-xs font-semibold ${
                        player.rank === 1 ? 'bg-yellow-400 text-yellow-900' :
                        player.rank === 2 ? 'bg-gray-300 text-gray-700' :
                        player.rank === 3 ? 'bg-amber-600 text-amber-100' :
                        'bg-pul-light text-pul-gray'
                      }`}>{player.rank}</span>
                      <div>
                        <span class="text-sm">{player.player}</span>
                        <div class="text-xs text-pul-gray">{player.team}</div>
                      </div>
                    </div>
                    <span class="font-semibold tabular-nums">{player.blocks}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Top Teams -->
      {teams.length > 0 && (
        <section>
          <div class="flex items-baseline justify-between mb-4">
            <h2 class="text-xl font-semibold">Top Teams by Goals</h2>
            <a href="/Stats-Hub/teams" class="text-sm text-pul-gray hover:text-pul-black transition-colors">
              View all →
            </a>
          </div>

          <div class="grid sm:grid-cols-3 gap-4">
            {topTeams.map((team, i) => (
              <a
                href={`/Stats-Hub/teams/${encodeURIComponent(team.team)}`}
                class="border border-pul-border rounded-lg p-4 hover:border-pul-black transition-colors"
              >
                <div class="flex items-center gap-3 mb-2">
                  <span class={`w-6 h-6 rounded-full flex items-center justify-center text-sm font-semibold ${
                    i === 0 ? 'bg-yellow-400 text-yellow-900' :
                    i === 1 ? 'bg-gray-300 text-gray-700' :
                    'bg-amber-600 text-amber-100'
                  }`}>{i + 1}</span>
                  <span class="font-semibold">{team.team}</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center text-sm">
                  <div>
                    <div class="font-semibold">{team.goals}</div>
                    <div class="text-pul-gray text-xs">Goals</div>
                  </div>
                  <div>
                    <div class="font-semibold">{team.blocks}</div>
                    <div class="text-pul-gray text-xs">Blocks</div>
                  </div>
                  <div>
                    <div class="font-semibold">{team.completionRate}%</div>
                    <div class="text-pul-gray text-xs">Comp</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div><!-- /main content column -->
  </div><!-- /grid -->
</Layout>

<script>
  const toggle = document.getElementById('upcoming-toggle');
  const body = document.getElementById('upcoming-body');
  const chevron = document.getElementById('upcoming-chevron');

  toggle?.addEventListener('click', () => {
    const isOpen = body?.classList.contains('hidden') === false;
    body?.classList.toggle('hidden', isOpen);
    chevron?.classList.toggle('rotate-180', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
