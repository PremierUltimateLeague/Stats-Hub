---
import Layout from '../layouts/Layout.astro';
import EmptySeasonState from '../components/EmptySeasonState.astro';
import SeasonSelect from '../components/SeasonSelect.astro';

import { StatsTable } from '../components/StatsTable';
import PostseasonToggleTable from '../components/PostseasonToggleTable';
import PostseasonFilterTable from '../components/PostseasonFilterTable';
import { loadSeasonData, findDefaultSeason } from '../utils/seasonLoader';
import { seasons } from '../config/seasons';
import { teamLogos } from '../utils/teams';

const teamsOverallBySeason = loadSeasonData(seasons, 'teams_season.json');
const teamsGamesBySeason = loadSeasonData(seasons, 'teams_games.json');

const defaultSeason = findDefaultSeason(
  seasons,
  teamsOverallBySeason,
  ['goals', 'breakGoals', 'blocks']
);

const overallColumns = [
  { accessorKey: 'team', header: 'Team', size: 180 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'breakGoals', header: 'Breaks', size: 80 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'holds', header: 'Holds', size: 70 },
  { accessorKey: 'cleanHolds', header: 'Clean Holds', size: 100 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: 'passAttempts', header: 'Pass Att.', size: 90 },
  { accessorKey: 'completedPasses', header: 'Comp. Passes', size: 110 },
  { accessorKey: 'completionRate', header: 'Comp. %', size: 90 },
  { accessorKey: 'hucks', header: 'Hucks', size: 70 },
];

const overallHiddenByDefault = [
  'passAttempts',
  'completedPasses',
];

const gameColumns = [
  { accessorKey: 'team', header: 'Team', size: 180 },
  { accessorKey: 'match', header: 'Match', size: 130 },
  { accessorKey: 'week', header: 'Week', size: 80 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'breakGoals', header: 'Break Goals', size: 100 },
  { accessorKey: 'holds', header: 'Holds', size: 70 },
  { accessorKey: 'cleanHolds', header: 'Clean Holds', size: 100 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: 'passAttempts', header: 'Pass Att.', size: 90 },
  { accessorKey: 'completedPasses', header: 'Comp. Passes', size: 110 },
  { accessorKey: 'completionRate', header: 'Comp. %', size: 80 },
  { accessorKey: 'hucks', header: 'Hucks', size: 70 },
];

const gameHiddenByDefault = [
  'passAttempts',
  'completedPasses',
];
---

<Layout title="Team Stats">
  <div class="space-y-6">
    <div class="flex items-baseline justify-between flex-wrap gap-4">
      <h1 class="text-3xl font-semibold">
      <span id="teams-title">{defaultSeason}</span> Team Stats</h1>
      <SeasonSelect 
        seasons={seasons} 
        defaultSeason={defaultSeason} 
        titleId="teams-title" 
      />
    </div>

    <!-- Tabs -->
    <div class="border-b border-pul-border">
      <nav class="flex gap-6">
        <button class="tab-btn py-3 text-sm font-medium border-b-2 border-pul-black" data-tab="overall">
          Overall
        </button>
        <button class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-pul-gray hover:text-pul-black" data-tab="by-game">
          By Game
        </button>
      </nav>
    </div>

    {seasons.map(season => (
      <div data-season={season} class={season === defaultSeason ? '' : 'hidden'}>
        <!-- Overall Tab -->
        <div data-tab-content="overall">
          {teamsOverallBySeason[season].some(t => (t.goals || 0) + (t.blocks || 0) + (t.breakGoals || 0) > 0) ? (
            <PostseasonToggleTable 
              client:load
              regularSeasonData={teamsOverallBySeason[season]}
              gamesData={teamsGamesBySeason[season]}
              aggregationMode="team"
              columns={overallColumns}
              defaultHiddenColumns={overallHiddenByDefault}
              searchPlaceholder="Search teams..."
              searchableColumns={['team']}
              linkColumn="team"
              linkPrefix="/Stats-Hub/teams/"
              showTeamLogos={true}
              teamLogos={teamLogos}
            />
          ) : (
            <EmptySeasonState type="team" />
          )}
        </div>

      <!-- By Game Tab -->
      <div data-tab-content="by-game" class="hidden">
        {teamsGamesBySeason[season].some(t => (t.goals || 0) + (t.blocks || 0) + (t.breakGoals || 0) > 0) ? (
          <PostseasonFilterTable 
          client:load
          data={teamsGamesBySeason[season]}
          columns={gameColumns}
          defaultHiddenColumns={gameHiddenByDefault}
          searchPlaceholder="Search teams or matches..."
          searchableColumns={['team', 'match']}
          filterColumn="week"
          filterLabel="Weeks"
          showTeamLogos={true}
          teamLogos={teamLogos}
          linkColumn="team"
          linkPrefix="/Stats-Hub/teams/"
          gameLinkColumn="match"
        />
        ) : (
          <EmptySeasonState type="game" />
        )}
      </div>
      </div>
    ))}
  </div>

<script>
  import '../scripts/tabSwitcher';
</script>
</Layout>