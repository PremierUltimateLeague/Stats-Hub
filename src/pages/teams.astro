---
import Layout from '../layouts/Layout.astro';
import { StatsTable } from '../components/StatsTable';
import fs from 'node:fs';
import path from 'node:path';

// Available seasons
const seasons = ['2025', '2024'];

// Load data for all seasons
const teamsDataBySeason: Record<string, any[]> = {};

// Load 2025
try {
  const data2025 = fs.readFileSync(path.join(process.cwd(), 'data', '2025', 'teams_season.json'), 'utf-8');
  teamsDataBySeason['2025'] = JSON.parse(data2025);
} catch (e) {
  teamsDataBySeason['2025'] = [];
}

// Load 2024
try {
  const data2024 = fs.readFileSync(path.join(process.cwd(), 'data', '2024', 'teams_season.json'), 'utf-8');
  teamsDataBySeason['2024'] = JSON.parse(data2024);
} catch (e) {
  teamsDataBySeason['2024'] = [];
}

const columns = [
  { accessorKey: 'team', header: 'Team', size: 180 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'breakGoals', header: 'Breaks', size: 70 },
  { accessorKey: 'blocks', header: 'Blocks', size: 70 },
  { accessorKey: 'holds', header: 'Holds', size: 70 },
  { accessorKey: 'turnovers', header: 'TO', size: 70 },
  { accessorKey: 'completionRate', header: 'Comp %', size: 80 },
];
---

<Layout title="Team Stats">
  <div class="space-y-8">
    <div class="flex items-baseline justify-between flex-wrap gap-4">
      <h1 class="text-3xl font-semibold">Team Stats</h1>
      <select 
        id="season-select"
        class="search-input text-sm"
      >
        {seasons.map(season => (
          <option value={season}>{season} Season</option>
        ))}
      </select>
    </div>

    {seasons.map(season => (
      <div 
        id={`season-${season}`} 
        class={season === '2025' ? '' : 'hidden'}
        data-season={season}
      >
        {teamsDataBySeason[season].length > 0 ? (
          <StatsTable 
            client:load
            data={teamsDataBySeason[season]}
            columns={columns}
            searchPlaceholder="Search teams..."
            searchableColumns={['team']}
            linkColumn="team"
            linkPrefix="/Stats-Hub/teams/"
          />
        ) : (
          <p class="text-pul-gray">No team data available for {season}.</p>
        )}
      </div>
    ))}
  </div>

  <script>
    const select = document.getElementById('season-select') as HTMLSelectElement;
    const seasonDivs = document.querySelectorAll('[data-season]');
    
    select?.addEventListener('change', () => {
      const selected = select.value;
      seasonDivs.forEach(div => {
        if (div.getAttribute('data-season') === selected) {
          div.classList.remove('hidden');
        } else {
          div.classList.add('hidden');
        }
      });
    });
  </script>
</Layout>