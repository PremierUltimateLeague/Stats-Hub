---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { seasons } from '../config/seasons';

// Team logo mapping
const teamLogos: Record<string, string> = {
  'Atlanta Soul': 'atlanta.png',
  'Austin Torch': 'austin.png',
  'Columbus Pride': 'columbus.png',
  'DC Shadow': 'dc.png',
  'Indy Red': 'indy.png',
  'LA Astra': 'la.png',
  'Medellin Revolution': 'medellin.png',
  'Milwaukee Monarchs': 'milwaukee.png',
  'Minnesota Strike': 'minnesota.png',
  'Nashville NightShade': 'nashville.png',
  'New York Gridlock': 'new-york.png',
  'Philadelphia Surge': 'philadelphia.png',
  'Portland Rising': 'portland.png',
  'Raleigh Radiance': 'raleigh.png',
};

// Aggregate career stats
const allPlayers: Map<string, any> = new Map();

// Also store per-season data
const playersBySeason: Record<string, any[]> = {};

for (const season of seasons) {
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'players_season.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const players = JSON.parse(rawData)
      .filter((p: any) => p.player && typeof p.player === 'string');
    playersBySeason[season] = players;
  } catch (e) {
    playersBySeason[season] = [];
  }
}

for (const season of seasons) {
  try {
    const dataPath = path.join(process.cwd(), 'data', season, 'players_season.json');
    const rawData = fs.readFileSync(dataPath, 'utf-8');
    const players = JSON.parse(rawData);
    
    players.forEach((player: any) => {
      if (!player.player || typeof player.player !== 'string') return;
      
      // Normalize key for dedup
      const key = player.player.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      
      if (allPlayers.has(key)) {
        const existing = allPlayers.get(key);
        existing.goals += player.goals || 0;
        existing.assists += player.assists || 0;
        existing.blocks += player.blocks || 0;
        existing.turnovers += player.turnovers || 0;
        existing.touches += player.touches || 0;
        existing.seasons.push(season);
      } else {
        allPlayers.set(key, {
          player: player.player,  // Keep original name for display
          team: player.team,
          goals: player.goals || 0,
          assists: player.assists || 0,
          blocks: player.blocks || 0,
          turnovers: player.turnovers || 0,
          touches: player.touches || 0,
          seasons: [season],
        });
      }
    });
  } catch (e) {}
}

const playerList = Array.from(allPlayers.values())
  .filter(p => p.player && typeof p.player === 'string')
  .sort((a, b) => a.player.localeCompare(b.player));
---

<Layout title="Compare Players">
  <div class="space-y-6">
   <div class="flex items-baseline justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-3xl font-semibold">Compare Players</h1>
        <p class="text-pul-gray mt-1">Select 2-3 players to compare their stats side-by-side</p>
      </div>
      <select id="compare-season" class="search-input text-sm">
        <option value="career">Career Totals</option>
        <option value="2025">2025 Season</option>
        <option value="2024">2024 Season</option>
      </select>
    </div>

    <!-- Player Selection -->
    <div class="grid sm:grid-cols-3 gap-4">
      {[1, 2, 3].map(num => (
        <div>
          <label class="block text-sm font-medium mb-2">
            Player {num} {num === 3 && <span class="text-pul-gray font-normal">(optional)</span>}
          </label>
          <div class="relative" data-player-select={num}>
            <input 
              type="text" 
              id={`player${num}`}
              class="search-input w-full pr-16" 
              placeholder="Type to search..." 
              autocomplete="off" 
            />
            <button 
              type="button"
              class="clear-btn absolute right-8 top-1/2 -translate-y-1/2 text-pul-gray hover:text-pul-black hidden"
              data-clear={num}
              title="Clear"
            >
              ✕
            </button>
            <button 
              type="button"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-pul-gray hover:text-pul-black"
              data-toggle={num}
            >
              ▼
            </button>
            <div 
              id={`dropdown-${num}`}
              class="absolute z-20 w-full mt-1 bg-white border border-pul-border rounded-lg shadow-lg max-h-60 overflow-auto hidden"
            >
            </div>
          </div>
        </div>
      ))}
    </div>

<!-- Action Buttons -->
    <div class="flex justify-between items-center min-h-[40px]">
      <button 
        id="clear-all-btn"
        class="hidden text-sm text-red-600 hover:text-red-800 transition-colors"
      >
        ✕ Clear all
      </button>
      <div class="flex-1"></div>
      <button 
        id="share-btn"
        class="hidden flex items-center gap-2 px-4 py-2 text-sm text-pul-gray hover:text-pul-black border border-pul-border rounded-lg hover:border-pul-black transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
          <polyline points="16 6 12 2 8 6"/>
          <line x1="12" y1="2" x2="12" y2="15"/>
        </svg>
        Share Comparison
      </button>
    </div>

    <!-- Comparison Results -->
    <div id="comparison" class="hidden">
      <p id="compare-subtitle" class="text-sm text-pul-gray mb-3">Comparing career totals across all seasons</p>
        <div class="border border-pul-border rounded-lg overflow-hidden">
        <div id="player-headers" class="grid border-b border-pul-border bg-pul-light"></div>
        <div id="stats-rows" class="divide-y divide-pul-border"></div>
      </div>
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="text-center py-12">
      <p class="text-pul-gray mb-4">Select at least 2 players to compare</p>
      <div class="text-sm text-pul-gray">
        <p class="mb-2">Try comparing:</p>
        <ul class="space-y-1">
          <li>• Top scorers from different teams</li>
          <li>• Players at the same position</li>
          <li>• Rookies vs veterans</li>
        </ul>
      </div>
      <div class="mt-6 flex justify-center gap-4">
        <a href="/Stats-Hub/leaders" class="text-sm text-pul-black hover:underline">View Leaders</a>
        <a href="/Stats-Hub/search" class="text-sm text-pul-black hover:underline">Search Players</a>
      </div>
    </div>

    <!-- Toast notification -->
    <div id="toast" class="fixed bottom-4 left-1/2 -translate-x-1/2 bg-pul-black text-white px-4 py-2 rounded-lg shadow-lg opacity-0 transition-opacity duration-300 pointer-events-none">
      Link copied to clipboard!
    </div>
  </div>
  </div>

<script define:vars={{ playerList, teamLogos, playersBySeason }}>
    const inputs = [
      document.getElementById('player1'),
      document.getElementById('player2'),
      document.getElementById('player3')
    ];
    const dropdowns = [
      document.getElementById('dropdown-1'),
      document.getElementById('dropdown-2'),
      document.getElementById('dropdown-3')
    ];
    const toggles = document.querySelectorAll('[data-toggle]');
    const comparison = document.getElementById('comparison');
    const emptyState = document.getElementById('empty-state');
    const clearAllBtn = document.getElementById('clear-all-btn');
    const playerHeaders = document.getElementById('player-headers');
    const statsRows = document.getElementById('stats-rows');
    const toast = document.getElementById('toast');

    // Track selected players
    const selectedPlayers = [null, null, null];

    let currentSeason = 'career';
    const compareSeasonSelect = document.getElementById('compare-season');
    
    compareSeasonSelect?.addEventListener('change', (e) => {
      currentSeason = e.target.value;
      // Re-resolve selected players with new season data
      selectedPlayers.forEach((player, index) => {
        if (player) {
          const resolved = getPlayerForSeason(player.player);
          if (resolved) {
            selectedPlayers[index] = resolved;
          }
        }
      });
      updateComparison();
      updateURL();
      // Re-render any visible dropdowns
      dropdowns.forEach((dropdown, i) => {
        if (!dropdown.classList.contains('hidden')) {
          renderDropdown(i, inputs[i].value);
        }
      });
    });
    
    function getPlayerForSeason(playerName) {
      if (currentSeason === 'career') {
        return playerList.find(p => p.player === playerName) || null;
      }
      const seasonPlayers = playersBySeason[currentSeason] || [];
      const found = seasonPlayers.find(p => p.player === playerName);
      if (found) return found;
      // Return a shell object so the player stays selected but shows no stats
      const careerPlayer = playerList.find(p => p.player === playerName);
      if (careerPlayer) {
        return { player: careerPlayer.player, team: careerPlayer.team, _noData: true };
      }
      return null;
    }

    // Clear button handlers
    const clearBtns = document.querySelectorAll('.clear-btn');
    clearBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const index = parseInt(btn.getAttribute('data-clear')) - 1;
        selectedPlayers[index] = null;
        inputs[index].value = '';
        btn.classList.add('hidden');
        updateComparison();
        updateURL();
      });
    });

    // Clear all button handler
    clearAllBtn?.addEventListener('click', () => {
      selectedPlayers[0] = null;
      selectedPlayers[1] = null;
      selectedPlayers[2] = null;
      inputs[0].value = '';
      inputs[1].value = '';
      inputs[2].value = '';
      // Hide all clear buttons
      clearBtns.forEach(btn => btn.classList.add('hidden'));
      updateComparison();
      updateURL();
    });

    function getPlayerDisplay(player) {
      const match = player.player.match(/^(\d+)\s+(.+)$/);
      const name = match ? match[2] : player.player;
      const number = match ? match[1] : '';
      return { name, number, full: `${name}${number ? ' #' + number : ''} (${player.team})` };
    }

    function normalizeString(str) {
      return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    }

    function getPlayerListForSeason() { 
      if (currentSeason === 'career') return playerList;
      const seasonPlayers = playersBySeason[currentSeason] || [];
      if (seasonPlayers.length === 0) return playerList;
      return seasonPlayers
        .filter(p => p.player && typeof p.player === 'string')
        .sort((a, b) => a.player.localeCompare(b.player));
    }

    function renderDropdown(index, filter = '') {
      const dropdown = dropdowns[index];
      const q = normalizeString(filter);
      const currentList = getPlayerListForSeason();
      
      // Get already selected player names (excluding current index)
      const selectedNames = selectedPlayers
        .filter((p, i) => p && i !== index)
        .map(p => p.player);
      
      const filtered = (q 
        ? currentList.filter(p => normalizeString(getPlayerDisplay(p).full).includes(q))
        : currentList
      ).filter(p => !selectedNames.includes(p.player));
      
      const limited = filtered.slice(0, 50);
      
      dropdown.innerHTML = limited.map(player => {
        const display = getPlayerDisplay(player);
        const logo = teamLogos[player.team];
        return `
          <div 
            class="flex items-center gap-3 px-3 py-2 cursor-pointer hover:bg-pul-light"
            data-player-value="${player.player}"
          >
            ${logo ? `<img src="/Stats-Hub/images/teams/${logo}" class="w-6 h-6 object-contain" />` : '<div class="w-6"></div>'}
            <div>
              <div class="text-sm font-medium">${display.name} ${display.number ? `<span class="text-pul-gray">#${display.number}</span>` : ''}</div>
              <div class="text-xs text-pul-gray">${player.team}</div>
            </div>
          </div>
        `;
      }).join('');

      if (filtered.length > 50) {
        dropdown.innerHTML += `<div class="px-3 py-2 text-xs text-pul-gray text-center">Type to narrow results...</div>`;
      }

      if (filtered.length === 0) {
        dropdown.innerHTML = `<div class="px-3 py-2 text-sm text-pul-gray text-center">No players found</div>`;
      }

      // Add click handlers
      dropdown.querySelectorAll('[data-player-value]').forEach(el => {
        el.addEventListener('mousedown', (e) => {
          e.preventDefault();
          const playerName = el.getAttribute('data-player-value');
          selectPlayer(index, playerName);
        });
      });
    }

    let isUpdating = false;

    function selectPlayer(index, playerName) {
      const player = getPlayerForSeason(playerName);
      if (player) {
        isUpdating = true;
        selectedPlayers[index] = player;
        inputs[index].value = getPlayerDisplay(player).full;
        dropdowns[index].classList.add('hidden');
        document.querySelector(`[data-clear="${index + 1}"]`)?.classList.remove('hidden');
        updateComparison();
        updateURL();
        setTimeout(() => { isUpdating = false; }, 200);
      }
    }

    function updateURL() {
      const players = selectedPlayers.filter(Boolean);
      if (players.length >= 2) {
        const params = players.map(p => encodeURIComponent(p.player)).join('&p=');
        const seasonParam = currentSeason !== 'career' ? `&season=${currentSeason}` : '';
        const newURL = `${window.location.pathname}?p=${params}${seasonParam}`;
        window.history.replaceState({}, '', newURL);
      } else {
        window.history.replaceState({}, '', window.location.pathname);
      }
    }

    function showDropdown(index) {
      dropdowns.forEach((d, i) => {
        if (i === index) {
          d.classList.remove('hidden');
          renderDropdown(i, inputs[i].value);
        } else {
          d.classList.add('hidden');
        }
      });
    }

    function hideAllDropdowns() {
      dropdowns.forEach(d => d.classList.add('hidden'));
    }

    // Input handlers
// Track highlighted item per dropdown
    const highlightIndex = [0, 0, 0];

    function updateHighlight(dropdownIndex) {
      const items = dropdowns[dropdownIndex].querySelectorAll('[data-player-value]');
      items.forEach((item, i) => {
        if (i === highlightIndex[dropdownIndex]) {
          item.classList.add('bg-pul-light');
        } else {
          item.classList.remove('bg-pul-light');
        }
      });
      // Scroll highlighted item into view
      const highlighted = items[highlightIndex[dropdownIndex]];
      if (highlighted) {
        highlighted.scrollIntoView({ block: 'nearest' });
      }
    }

    inputs.forEach((input, index) => {
      input.addEventListener('focus', () => showDropdown(index));
      input.addEventListener('input', () => {
        selectedPlayers[index] = null;
        highlightIndex[index] = 0;
        renderDropdown(index, input.value);
        updateComparison();
        updateURL();
      });
      input.addEventListener('keydown', (e) => {
        const items = dropdowns[index].querySelectorAll('[data-player-value]');
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          highlightIndex[index] = Math.min(highlightIndex[index] + 1, items.length - 1);
          updateHighlight(index);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          highlightIndex[index] = Math.max(highlightIndex[index] - 1, 0);
          updateHighlight(index);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          const highlighted = items[highlightIndex[index]];
          if (highlighted) {
            const playerName = highlighted.getAttribute('data-player-value');
            selectPlayer(index, playerName);
          }
        } else if (e.key === 'Escape') {
          dropdowns[index].classList.add('hidden');
          input.blur();
        }
      });
      input.addEventListener('blur', () => {
        setTimeout(() => {
          if (!isUpdating) {
            dropdowns[index].classList.add('hidden');
            highlightIndex[index] = 0;
          }
        }, 150);
      });
    });

    // Toggle button handlers
    toggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        const index = parseInt(toggle.getAttribute('data-toggle')) - 1;
        const dropdown = dropdowns[index];
        if (dropdown.classList.contains('hidden')) {
          showDropdown(index);
          inputs[index].focus();
        } else {
          hideAllDropdowns();
        }
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!e.target.closest('[data-player-select]')) {
        hideAllDropdowns();
      }
    });

    // Share button handler
    const shareBtn = document.getElementById('share-btn');
    shareBtn?.addEventListener('click', async () => {
      const players = selectedPlayers.filter(Boolean);
      if (players.length < 2) return;

      const params = players.map(p => encodeURIComponent(p.player)).join('&p=');
      const url = `${window.location.origin}${window.location.pathname}?p=${params}`;
      const names = players.map(p => getPlayerDisplay(p).name).join(' vs ');
      
      // Try native share first (mobile)
      if (navigator.share) {
        try {
          await navigator.share({
            title: `PUL Stats: ${names}`,
            url: url
          });
          return;
        } catch (err) {}
      }
      
      // Fall back to clipboard
      try {
        await navigator.clipboard.writeText(url);
        showToast();
      } catch (err) {
        const textarea = document.createElement('textarea');
        textarea.value = url;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        showToast();
      }
    });

    function showToast() {
      if (toast) {
        toast.classList.remove('opacity-0');
        toast.classList.add('opacity-100');
        setTimeout(() => {
          toast.classList.remove('opacity-100');
          toast.classList.add('opacity-0');
        }, 2000);
      }
    }

    // Stats config
    const stats = [
      { key: 'goals', label: 'Goals', icon: '🥏' },
      { key: 'assists', label: 'Assists', icon: '🎯' },
      { key: 'blocks', label: 'Blocks', icon: '🛡️' },
      { key: 'turnovers', label: 'Turnovers', icon: '↩️', inverse: true },
      { key: 'touches', label: 'Touches', icon: '✋' },
    ];

    function updateComparison() {
      const players = selectedPlayers.filter(Boolean);
      
      // Show/hide clear all button
      if (players.length > 0) {
        clearAllBtn?.classList.remove('hidden');
      } else {
        clearAllBtn?.classList.add('hidden');
      }

      if (players.length === 0) {
        comparison.classList.add('hidden');
        emptyState.classList.remove('hidden');
        emptyState.innerHTML = `
          <p class="text-pul-gray mb-4">Select at least 2 players to compare</p>
          <div class="text-sm text-pul-gray">
            <p class="mb-2">Try comparing:</p>
            <ul class="space-y-1">
              <li>• Top scorers from different teams</li>
              <li>• Players at the same position</li>
              <li>• Rookies vs veterans</li>
            </ul>
          </div>
          <div class="mt-6 flex justify-center gap-4">
            <a href="/Stats-Hub/leaders" class="text-sm text-pul-black hover:underline">View Leaders</a>
            <a href="/Stats-Hub/search" class="text-sm text-pul-black hover:underline">Search Players</a>
          </div>
        `;
        shareBtn?.classList.add('hidden');
        return;
      }

      if (players.length === 1) {
        comparison.classList.add('hidden');
        emptyState.classList.remove('hidden');
        emptyState.innerHTML = `<p class="text-pul-gray">Select 1 more player to compare</p>`;
        shareBtn?.classList.add('hidden');
        return;
      }

      comparison.classList.remove('hidden');
      emptyState.classList.add('hidden');
      shareBtn?.classList.remove('hidden');

      // Update subtitle
      const subtitle = document.getElementById('compare-subtitle');
      if (subtitle) {
        subtitle.textContent = currentSeason === 'career' 
          ? 'Comparing career totals across all seasons'
          : `Comparing ${currentSeason} season stats`;
      }

      const numPlayers = players.length;
      const gridCols = numPlayers === 2 ? 'grid-cols-3' : 'grid-cols-4';

      // Render headers
      playerHeaders.className = `grid ${gridCols} border-b border-pul-border bg-pul-light`;
      playerHeaders.innerHTML = `
        <div class="p-4"></div>
        ${players.map(player => {
          const display = getPlayerDisplay(player);
          const logo = teamLogos[player.team];
          return `
            <div class="p-4 text-center">
              <a href="/Stats-Hub/players/${encodeURIComponent(player.player)}" class="hover:underline">
                ${logo ? `<img src="/Stats-Hub/images/teams/${logo}" alt="${player.team}" class="w-10 h-10 object-contain mx-auto mb-2" />` : ''}
                <div class="font-semibold">${display.name}</div>
                ${display.number ? `<div class="text-sm text-pul-gray">#${display.number}</div>` : ''}
                <div class="text-xs text-pul-gray">${player.team}</div>
              </a>
            </div>
          `;
        }).join('')}
      `;

      // Render stats
        statsRows.innerHTML = stats.map(stat => {
        const values = players.map(p => p._noData ? null : (p[stat.key] !== undefined ? p[stat.key] : null));
        const numericValues = values.filter(v => v !== null);
        const best = numericValues.length > 0 
          ? (stat.inverse ? Math.min(...numericValues) : Math.max(...numericValues))
          : 0;
        
        return `
          <div class="grid ${gridCols}">
            <div class="p-4 flex items-center gap-2">
              <span>${stat.icon}</span>
              <span class="font-medium">${stat.label}</span>
            </div>
            ${players.map(player => {
              const value = player[stat.key];
              const hasData = value !== undefined && value !== null;
              const isBest = hasData && value === best && numericValues.filter(v => v === best).length === 1;
              return `
                <div class="p-4 text-center">
                  ${hasData 
                    ? `<span class="text-2xl font-bold ${isBest ? 'text-green-600' : ''}">${value}</span>`
                    : `<span class="text-sm text-pul-gray">Did not play</span>`
                  }
                </div>
              `;
            }).join('')}
          </div>
        `;
      }).join('');

      // Add totals row
      const totals = players.map(p => {
        if (p._noData || (p.goals === undefined && p.assists === undefined)) return null;
        return (p.goals || 0) + (p.assists || 0);
      });
      const numericTotals = totals.filter(t => t !== null);
      const bestTotal = numericTotals.length > 0 ? Math.max(...numericTotals) : 0;
      statsRows.innerHTML += `
        <div class="grid ${gridCols} bg-pul-light">
          <div class="p-4 flex items-center gap-2">
            <span>⭐</span>
            <span class="font-medium">Goals + Assists</span>
          </div>
          ${players.map((player, i) => {
            const total = totals[i];
            const hasData = total !== null;
            const isBest = hasData && total === bestTotal && numericTotals.filter(t => t === bestTotal).length === 1;
            return `
              <div class="p-4 text-center">
                ${hasData
                  ? `<span class="text-2xl font-bold ${isBest ? 'text-green-600' : ''}">${total}</span>`
                  : `<span class="text-sm text-pul-gray">Did not play</span>`
                }
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    // Load players from URL on page load
    const urlParams = new URLSearchParams(window.location.search);
    const playerParams = urlParams.getAll('p');
    const seasonParam = urlParams.get('season');
    
    if (seasonParam && compareSeasonSelect) {
      currentSeason = seasonParam;
      compareSeasonSelect.value = seasonParam;
    }
    
    if (playerParams.length >= 2) {
      playerParams.slice(0, 3).forEach((playerName, index) => {
        const player = getPlayerForSeason(playerName);
        if (player) {
          selectedPlayers[index] = player;
          inputs[index].value = getPlayerDisplay(player).full;
          document.querySelector(`[data-clear="${index + 1}"]`)?.classList.remove('hidden');
        }
      });
      updateComparison();
    }
  </script>
</Layout>