---
import Layout from '../layouts/Layout.astro';
import EmptySeasonState from '../components/EmptySeasonState.astro';
import SeasonSelect from '../components/SeasonSelect.astro';

import { StatsTable } from '../components/StatsTable';
import { loadSeasonData, findDefaultSeason } from '../utils/seasonLoader';
import { seasons } from '../config/seasons';

const playersOverallBySeason = loadSeasonData(seasons, 'players_season.json');
const playersGamesBySeason = loadSeasonData(seasons, 'players_games.json');

const defaultSeason = findDefaultSeason(
  seasons,
  playersOverallBySeason,
  ['goals', 'assists', 'blocks']
);

const overallColumns = [
  { accessorKey: 'player', header: 'Player', size: 200 },
  { accessorKey: 'team', header: 'Team', size: 160 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'assists', header: 'Assists', size: 80 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: 'touches', header: 'Touches', size: 90 },
  { accessorKey: '+/-', header: '+/-', size: 70 },
];

const gameColumns = [
  { accessorKey: 'player', header: 'Player', size: 180 },
  { accessorKey: 'team', header: 'Team', size: 140 },
  { accessorKey: 'match', header: 'Match', size: 130 },
  { accessorKey: 'week', header: 'Week', size: 80 },
  { accessorKey: 'goals', header: 'Goals', size: 70 },
  { accessorKey: 'assists', header: 'Assists', size: 80 },
  { accessorKey: 'blocks', header: 'Blocks', size: 80 },
  { accessorKey: 'turnovers', header: 'Turnovers', size: 90 },
  { accessorKey: '+/-', header: '+/-', size: 70 },
];
---

<Layout title="Player Stats">
  <div class="space-y-6">
    <div class="flex items-baseline justify-between flex-wrap gap-4">
      <h1 class="text-3xl font-semibold">
        <span id="players-title">{defaultSeason}</span> Player Stats
      </h1>
      <SeasonSelect 
        seasons={seasons} 
        defaultSeason={defaultSeason} 
        titleId="players-title" 
      />
    </div>

    <!-- Tabs -->
    <div class="border-b border-pul-border">
      <nav class="flex gap-6">
        <button class="tab-btn py-3 text-sm font-medium border-b-2 border-pul-black" data-tab="overall">
          Overall
        </button>
        <button class="tab-btn py-3 text-sm font-medium border-b-2 border-transparent text-pul-gray hover:text-pul-black" data-tab="by-game">
          By Game
        </button>
      </nav>
    </div>

    <!-- Season View -->
    <div id="season-view">
      {seasons.map(season => (
        <div data-season={season} class={season === defaultSeason ? '' : 'hidden'}>
          <!-- Overall Tab -->
          <div data-tab-content="overall">
           {playersOverallBySeason[season].some(p => (p.goals || 0) + (p.assists || 0) + (p.blocks || 0) > 0) ? (
          <StatsTable 
            client:load
            data={playersOverallBySeason[season]}
            columns={overallColumns}
            searchPlaceholder="Search players..."
            searchableColumns={['player']}
            filterColumn="team"
            filterLabel="Teams"
            linkColumn="team"
            linkPrefix="/Stats-Hub/teams/"
            playerLinkColumn="player"
            gameLinkColumn="match"
          />
        ) : (
          <EmptySeasonState type="player" />
        )}
        </div>

        <!-- By Game Tab -->
        <div data-tab-content="by-game" class="hidden">
          {playersGamesBySeason[season].length > 0 ? (
            <StatsTable 
            client:load
            data={playersGamesBySeason[season]}
            columns={gameColumns}
            searchPlaceholder="Search players..."
            searchableColumns={['player']}
            filterColumn="team"
            filterLabel="Teams"
            linkColumn="team"
            linkPrefix="/Stats-Hub/teams/"
            playerLinkColumn="player"
          />
          ) : (
          <EmptySeasonState type="game" />
          )}
        </div>
      </div>
    ))}
  </div>

  <script>
  import '../scripts/tabSwitcher';
</script>
</Layout>