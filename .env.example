# Google Drive folder ID containing the PUL stats CSVs.
# Used by processing/fetch-drive-data.js to download season data.
# Set this as a repository secret (DRIVE_FOLDER_ID) for GitHub Actions,
# or export it locally when running the fetch script manually.
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# YouTube Data API v3 key for auto-fetching game video links.
# Used by processing/fetch-youtube-links.js.
# Set as a repository secret (YOUTUBE_API_KEY) for GitHub Actions.
YOUTUBE_API_KEY=your_youtube_api_key_here
